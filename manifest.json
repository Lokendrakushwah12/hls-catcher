{
  "manifest_version": 3,
  "name": "HLS Catcher",
  "version": "0.1.0",
  "description": "Detects HLS/DASH manifests a page requests and lists their variant streams.",
  "permissions": [
    "scripting",
    "webRequest",
    "declarativeNetRequest",
    "storage",
    "tabs",
    "sidePanel",
    "offscreen",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "side_panel": {
    "default_path": "popup.html?dock=1"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
